# Chave secreta para sessões (OBRIGATÓRIO em produção)
SECRET_KEY=gera-uma-chave-secreta-aqui

# Configuração LDAP
LDAP_SERVER_URI=ldap://127.0.0.1:1389
LDAP_BASE_DN=ou=people,dc=planetexpress,dc=com
LDAP_USER_DN_TEMPLATE=
LDAP_USER_DOMAIN=
LDAP_NTLM_DOMAIN=
LDAP_EMAIL_DOMAIN=planetexpress.com
LDAP_DEBUG=false

# Nível de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
